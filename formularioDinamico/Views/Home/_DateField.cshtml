@model FormField

<div class="space-y-2">
    <label for="@Model.Id" class="block text-sm font-semibold text-slate-700">@Model.Label</label>
    <input id="@Model.Id"
           name="@Model.Id"
           type="date"
           required="@Model.Required"
           class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 transition-all focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
</div>
