@model FormField
@inject FormularioDinamico.Factories.FieldRendererFactory RendererFactory

<section class="conditional-block hidden space-y-6 rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-5"
         data-depends-on="@Model.DependsOn?.Field"
         data-depends-value="@Model.DependsOn?.Value"
         data-field-group="@Model.Id">
    @foreach (var child in Model.Fields)
    {
        <partial name="@RendererFactory.ResolvePartial(child)" model="child" />
    }
</section>
