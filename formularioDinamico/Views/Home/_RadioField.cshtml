@model FormField

<fieldset class="space-y-3">
    <legend class="text-sm font-semibold text-slate-700">@Model.Label</legend>
    <div class="grid gap-3 sm:grid-cols-2">
        @foreach (var option in Model.Options)
        {
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-all hover:border-indigo-300 hover:bg-indigo-50/40">
                <input name="@Model.Id"
                       type="radio"
                       value="@option.Value"
                       required="@Model.Required"
                       class="h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-200" />
                <span class="font-medium text-slate-700">@option.Text</span>
            </label>
        }
    </div>
</fieldset>
